# ===========================================
# MBMB Website Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# These are REQUIRED for the AI chatbot to work

# -----------------------------
# OPTION B (PRIMARY — FASTEST & CHEAPEST):
# DeepSeek V3.2 Fast Brain + xAI Grok Voice 3.0 TTS
# -----------------------------
DEEPSEEK_API_KEY=your_deepseek_api_key_here
XAI_API_KEY=your_xai_grok_api_key_here
GROK_VOICE=ara

# -----------------------------
# FAILOVER 1: MiniMax
# Get your API key at: https://platform.minimaxi.com/
# -----------------------------
MINIMAX_API_KEY=your_minimax_api_key_here

# -----------------------------
# FAILOVER 2: Kimi/Moonshot AI
# Get your API key at: https://platform.moonshot.cn/
# -----------------------------
# KIMI_API_KEY=your_kimi_api_key_here

# -----------------------------
# FAILOVER 3: Google Cloud TTS (for voice output)
# Get your API key at: https://console.cloud.google.com/apis/credentials
# Enable "Text-to-Speech API" first
# -----------------------------
GOOGLE_TTS_API_KEY=your_google_tts_api_key_here

# ===========================================
# COST ESTIMATES (per month, with normal traffic)
# ===========================================
# MiniMax chat: ~$1-3/month
# Google TTS: ~$3-5/month
# Total: ~$4-8/month
#
# This is 5-10x cheaper than keeping Kimi for chat
# ===========================================
